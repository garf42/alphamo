# AlphaMo environment template — copy to `.env` and fill in.
#
# `.env` is loaded automatically by every `alphamo` invocation (search:
# CWD, then walk parents). Existing environment variables take precedence
# over `.env` values, so CI / production deployments that set vars
# out-of-band are unaffected.
#
# `alphamo doctor` reports which of these are set and where they came from.

# ---------------------------------------------------------------- REQUIRED

# Fireworks AI API key — required for the default Fireworks-routed
# provider configuration (Hyperparameters.provider_* defaults to
# "fireworks" across all five LLM-calling components).
#
# Get one at https://fireworks.ai/account/api-keys
#
# If this is unset and the run's HP routes any component to Fireworks
# (the default), the orchestrator raises at startup with a pointer back
# to this file.
FIREWORKS_API_KEY=

# ---------------------------------------------------------------- OPTIONAL

# Anthropic API key — only needed when a Hyperparameters override routes
# one or more components to "anthropic" instead of the default
# "fireworks". The default Sprint-15 configuration does NOT consult this.
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- CLI DEFAULTS
# These have safe defaults; uncomment to override.

# Path to the SQLite Programs DB. Default: ./alphamo.db
# ALPHAMO_DB=alphamo.db

# Path to the JSONL audit log. Default: ./runs/audit.jsonl
# ALPHAMO_AUDIT=runs/audit.jsonl

# Set to "1" to opt the Anthropic SDK in to the live-test marker. Live
# tests are skipped unless both this AND ANTHROPIC_API_KEY are set.
# RUN_LIVE_TESTS=
